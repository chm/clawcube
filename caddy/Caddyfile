{
  admin off
  pki {
    ca clawcube {
      name "ClawCube"
      intermediate_lifetime 180d
    }
  }
}

(conf-ca-clawcube) {
  tls {
    issuer internal {
      ca clawcube
      lifetime 60d
    }
  }
}

clawcube.lan {
  import conf-ca-clawcube

  root * /www
  file_server
}

litellm.clawcube.lan {
  import conf-ca-clawcube

  reverse_proxy 127.0.0.1:4000
}

openclaw.clawcube.lan {
  import conf-ca-clawcube

  reverse_proxy 127.0.0.1:18789
}

picoclaw.clawcube.lan {
  import conf-ca-clawcube

  reverse_proxy 127.0.0.1:18800
}
